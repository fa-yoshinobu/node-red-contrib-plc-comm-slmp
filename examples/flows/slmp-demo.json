    {
        "id":  "prepare-demo-random",
        "type":  "function",
        "z":  "tab-slmp-demo",
        "name":  "Save snapshot + random values",
        "func":  "const original = {\n    'D300:U,3': Array.from(msg.payload['D300:U,3']),\n    'D320:STR,10': String(msg.payload['D320:STR,10'])\n};\nmsg.slmpSampleOriginal = original;\nmsg.updates = {\n    'D300:U,3': Array.from({ length: 3 }, function () { return Math.floor(Math.random() * 65536); }),\n    'D320:STR,10': Array.from({ length: 10 }, function () { return String.fromCharCode(65 + Math.floor(Math.random() * 26)); }).join('')\n};\ndelete msg.payload;\nreturn msg;",
        "outputs":  1,
        "noerr":  0,
        "initialize":  "",
        "finalize":  "",
