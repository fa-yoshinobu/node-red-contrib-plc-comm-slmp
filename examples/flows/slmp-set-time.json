    "type": "function",
    "z": "slmp-clock-iqr-clock",
    "name": "Write acknowledgements",
    "func": "msg.payload={status:\"clock request acknowledged\",requested:msg.requestedLocal};return msg;",
    "outputs": 1,
    "x": 910,
