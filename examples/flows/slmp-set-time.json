        "slmp-clock-date"
      ]
    ]
  },
  {
    "id": "slmp-clock-date",
    "type": "function",
    "z": "slmp-clock-iqr-clock",
    "name": "Explicit local Date",
    "func": "msg.payload=new Date(msg.payload);msg.requestedLocal=msg.payload.toLocaleString(\"ja-JP\",{hour12:false});return msg;",
    "outputs": 1,
    "x": 420,
    "y": 340,
    "wires": [
      [
        "slmp-clock-settime"
      ]
    ]
  },
  {
    "id": "slmp-clock-settime",
    "type": "slmp-set-time",
    "z": "slmp-clock-iqr-clock",
    "name": "Set PLC time",
    "connection": "slmp-clock-iqr-cfg",
    "x": 660,
    "y": 340,
    "wires": [
      [
        "slmp-clock-ack-format",
        "slmp-clock-set-delay"
      ]
    ]
  },
  {
