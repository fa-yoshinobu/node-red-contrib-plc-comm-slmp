    "type": "delay",
    "z": "slmp-clock-iqr-clock",
    "name": "Wait for clock update (0.5 s)",
    "pauseType": "delay",
    "timeout": "0.5",
    "timeoutUnits": "seconds",
    "rate": "1",
    "nbRateUnits": "1",
    "rateUnits": "second",
    "randomFirst": "1",
