    "z": "slmp-clock-iqr-clock",
    "name": "Set host local time (manual)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "payloadType": "date",
    "repeat": "",
    "crontab": "",
    "once": false,
    "x": 170,
    "y": 340,
    "wires": [
