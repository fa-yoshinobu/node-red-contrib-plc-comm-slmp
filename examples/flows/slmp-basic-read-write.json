        "type":  "function",
        "z":  "tab-slmp-basic",
        "name":  "Save snapshot + random word values",
        "func":  "const original = Object.assign({}, msg.payload);\nmsg.slmpSampleOriginal = original;\nmsg.slmpSampleRandomFloat = Math.fround((Math.random() * 2000) - 1000);\nmsg.updates = {\n    'D300:U': Math.floor(Math.random() * 65536),\n    'D301:U': Math.floor(Math.random() * 65536)\n};\ndelete msg.payload;\nreturn msg;",
